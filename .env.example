# === Local dev (SolidJS) ===
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Church
# Cloudinary CDN — free tier: https://cloudinary.com/pricing
# When set, Unsplash/remote URLs in site content are proxied through Cloudinary fetch (no upload needed).
VITE_CLOUDINARY_CLOUD_NAME=

# Admin CMS (local only — never ship a real token in a public client build)
VITE_ADMIN_API_TOKEN=

# Vite proxy target when using /api/v1 in the browser (default: http://localhost:8080)
# VITE_API_PROXY=http://localhost:8080
# Auth proxy (Better Auth) — default http://localhost:3001
# VITE_AUTH_PROXY=http://localhost:3001
VITE_AUTH_BASE_URL=/api/auth

# === Better Auth (apps/auth) ===
AUTH_PORT=3001
# Must be ≥32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret!!
# Public origin the browser uses (Vite). Cookies are issued for this host via the proxy.
BETTER_AUTH_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-super-admin
SUPER_ADMIN_NAME=Super Admin

# === Go API ===
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=church_session
ADMIN_API_TOKEN=dev-admin-token-change-me
MIGRATIONS_DIR=migrations

# Neon Postgres (required for CMS + assets) — use the pooled connection string.
# Go API uses GORM (gorm.io) on top of this URL; schema comes from apps/api/migrations.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# === Cloudinary ===
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=church-dev
