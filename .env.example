# === Local dev (SolidJS) ===
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Church
VITE_CLOUDINARY_CLOUD_NAME=

# Vite proxy target when using /api/v1 in the browser (default: http://localhost:8080)
# VITE_API_PROXY=http://localhost:8080

# === Go API ===
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=church_session

# Optional until Neon is connected
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_MIGRATE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

