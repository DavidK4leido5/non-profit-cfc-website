# === Local dev (SolidJS) ===
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Church
# Cloudinary CDN — free tier: https://cloudinary.com/pricing
# When set, Unsplash/remote URLs in site content are proxied through Cloudinary fetch (no upload needed).
VITE_CLOUDINARY_CLOUD_NAME=

# Admin CMS (local only — never ship a real token in a public client build)
VITE_ADMIN_API_TOKEN=

# Vite proxy targets (host machine). In Docker Compose these are overridden to
# in-network DNS: VITE_API_PROXY=http://api:8080  VITE_AUTH_PROXY=http://auth:3001
# VITE_API_PROXY=http://localhost:8080
# VITE_AUTH_PROXY=http://localhost:3001
VITE_AUTH_BASE_URL=/api/auth

# === Better Auth (apps/auth) — separate container on church_net ===
# Bind address inside the container (required so web/api can reach auth)
HOST=0.0.0.0
AUTH_PORT=3001
# Must be ≥32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret!!
# Public origin the browser uses (Vite). Cookies + OAuth callbacks use this host via the proxy.
BETTER_AUTH_URL=http://localhost:5173
# Block email/password sign-in until verified (verification links log to auth console without RESEND_API_KEY)
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-super-admin
SUPER_ADMIN_NAME=Super Admin

# Google OAuth (optional). Create credentials in Google Cloud Console.
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional transactional email (otherwise verification/reset links print in auth logs)
# RESEND_API_KEY=
# EMAIL_FROM=Church Auth <onboarding@resend.dev>

# === Go API ===
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=church_session
ADMIN_API_TOKEN=dev-admin-token-change-me
MIGRATIONS_DIR=migrations

# Shared secret between web nginx (or Vite proxy) and api/auth.
# When set, api/auth reject requests missing X-Church-Gateway (blocks direct *.run.app hits).
# Leave empty for local Vite without the header; required when ENV=production / NODE_ENV=production.
# Generate: openssl rand -hex 32
# GATEWAY_SHARED_SECRET=

# Neon Postgres (required for CMS + assets) — use the pooled connection string.
# Go API uses GORM (gorm.io) on top of this URL; schema comes from apps/api/migrations.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# === Cloudinary ===
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=church-dev
