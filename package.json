{
  "name": "church-page",
  "version": "1.0.0",
  "private": true,
  "description": "Church website monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=!@church/api",
    "dev:docker": "docker compose up --watch --remove-orphans",
    "dev:auth": "turbo run dev --filter=@church/auth",
    "auth:migrate": "pnpm --filter @church/auth auth:migrate",
    "auth:seed": "pnpm --filter @church/auth seed",
    "docker:auth": "docker compose up auth --build --remove-orphans",
    "dev:api": "docker compose up api --build --remove-orphans",
    "dev:api:watch": "docker compose up api --build --watch --remove-orphans",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down -v",
    "deps:ide": "pnpm install",
    "solidcn:add": "node ./scripts/solidcn-add.mjs",
    "build": "turbo run build",
    "storybook": "turbo run storybook --filter=@church/ui",
    "build-storybook": "turbo run build-storybook --filter=@church/ui",
    "swagger": "turbo run swagger --filter=@church/api",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.17.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.7"
  }
}
