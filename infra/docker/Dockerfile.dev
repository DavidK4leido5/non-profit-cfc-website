# Dev monorepo image: Node + pnpm + turbo + Go so `pnpm dev` orchestrates all apps.
FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="/usr/local/go/bin:${PNPM_HOME}:${PATH}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && curl -fsSL "https://go.dev/dl/go1.22.12.linux-amd64.tar.gz" | tar -C /usr/local -xz \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile

COPY . .

RUN chmod +x /app/infra/docker/entrypoint.sh

EXPOSE 5173 8080

ENTRYPOINT ["/app/infra/docker/entrypoint.sh"]
CMD ["pnpm", "dev"]
